# Copy to .env. Everything here is optional in development.

PORT=3000

# Default: PGlite (in-process PostgreSQL) stored in apps/api/.data — no Docker needed.
# For a real PostgreSQL (`docker compose up -d` in the repo root):
# DATABASE_URL=postgres://mvp:mvp@localhost:5432/mvp

# Required in production, at least 32 characters.
# JWT_SECRET=

# Without SMTP_URL login codes are printed to the server console.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=MVP <no-reply@example.com>
# Messages of the support form are sent on here (they are kept in the database either way).
# SUPPORT_EMAIL=support@example.com

# Secret of the admin endpoints (catalog import), at least 16 characters.
# Development default: dev-admin-token. In production the endpoints are closed without it.
# ADMIN_TOKEN=
