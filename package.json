{
  "name": "mvp",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @mvp/api dev",
    "dev:mobile": "pnpm --filter @mvp/mobile start",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @mvp/db generate",
    "catalog:import": "pnpm --filter @mvp/content import-catalog"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "~6.0.3"
  }
}
