# Copy to deploy/.env on the server. Never commit the real file.

# The domain of the API; its DNS A record points to the server. HTTPS is set up by Caddy.
API_DOMAIN=api.example.com

# The database password, used by the API and the backups.
POSTGRES_PASSWORD=

# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=

# At least 16 characters: the secret of the catalog import.
ADMIN_TOKEN=

# Login codes and support messages go by email.
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=MVP <no-reply@example.com>
SUPPORT_EMAIL=support@example.com
